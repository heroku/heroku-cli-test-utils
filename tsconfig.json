{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
  },
  "include": ["src", "test", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"],
}
